# Shadow AI Detector - Environment Configuration Template
# Copy this file to backend/.env and configure your local credentials.

# Database Configuration (MySQL 8.x)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=shadow_ai_detector

# Application & Security
APP_ENV=development
SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ML Model Paths
ML_MODEL_PATH=models/shadow_ai_detector_rf.joblib
ML_METADATA_PATH=models/model_metadata.json
